# Copy to .env and fill in real values. Never commit .env.
# Each value is read by the services that need it; others ignore it.

# --- Common (Phase 0) ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# From your machine use localhost; containers override this with redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- LLM (Phase 1) ---
# openai = real calls (needs OPENAI_API_KEY); fake = offline keyword guesses, free
LLM_PROVIDER=fake
OPENAI_API_KEY=
CLASSIFIER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o

# --- Storage (Phase 3) ---
DATABASE_PATH=./data/regci.sqlite3

# --- Thresholds (Phases 3-4) ---
WARN_THRESHOLD_PCT=3
CRITICAL_THRESHOLD_PCT=8
DRIFT_WINDOW=7
JUDGE_RATE_LIMIT=60/m

# --- Alerting and CI (Phases 4-6) ---
SLACK_WEBHOOK_URL=
ORCHESTRATOR_API_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080


# --- Eval pipeline (Phase 3) ---
# Local defaults; docker-compose.yml overrides the URLs and paths inside containers.
CLASSIFIER_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:8000
GOLDEN_DIR=./golden
PROMPTS_DIR=./prompts
JUDGE_PROMPT_VERSION=v1
MAX_INFRA_ERROR_RATE=0.1
TASK_MAX_RETRIES=3
FLOWER_BASIC_AUTH=admin:change-me
